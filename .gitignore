/target
# Sidecars generated while testing against the fixtures. Real sidecars for
# real data files belong in version control — that is the point of them —
# but the ones tdy writes next to testdata/ during a test run do not.
/testdata/**/*.tdy.toml
/testdata/**/*.tdy.lock

# Third-party data-wrangling corpora fetched by scripts/download_corpus.sh.
# Twenty-six upstream repositories with their own licences: cloned for
# testing, never vendored. `tests/corpus.rs` skips when this is absent, which
# is what CI sees.
/corpus/

# The Pollock data-loading benchmark, fetched by scripts/download_pollock.sh:
# 2,290 polluted CSVs plus its own scoring code and a venv for it. Same rule as
# `corpus/` — external, large, never vendored, and nothing in CI reads it.
/pollock/
/pollock-venv/
__pycache__/

# The Patterns manuscript and its literature pipeline live beside the code
# but are not part of it (separate authorship workflow, large PDFs).
/literature/
/paper/
/gap_reports/

# subagent-driven-development scratch (ledgers, briefs, review packages)
/.superpowers/
