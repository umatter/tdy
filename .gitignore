/target
# Sidecars generated while testing against the fixtures. Real sidecars for
# real data files belong in version control — that is the point of them —
# but the ones tdy writes next to testdata/ during a test run do not.
/testdata/**/*.tdy.toml
/testdata/**/*.tdy.lock

# Third-party data-wrangling corpora fetched by scripts/download_corpus.sh.
# Twenty-six upstream repositories with their own licences: cloned for
# testing, never vendored. `tests/corpus.rs` skips when this is absent, which
# is what CI sees.
/corpus/
