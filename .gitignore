/target
# Sidecars generated while testing against the fixtures. Real sidecars for
# real data files belong in version control — that is the point of them —
# but the ones tdy writes next to testdata/ during a test run do not.
/testdata/**/*.tdy.toml
/testdata/**/*.tdy.lock

# Third-party data-wrangling corpora fetched by scripts/download_corpus.sh.
# Twenty-six upstream repositories with their own licences: cloned for
# testing, never vendored. `tests/corpus.rs` skips when this is absent, which
# is what CI sees.
/corpus/

# The Pollock data-loading benchmark, fetched by scripts/download_pollock.sh:
# 2,290 polluted CSVs plus its own scoring code and a venv for it. Same rule as
# `corpus/` — external, large, never vendored, and nothing in CI reads it.
/pollock/
/pollock-venv/
__pycache__/

# The Patterns manuscript and its literature pipeline live beside the code
# but are not part of it (separate authorship workflow, large PDFs).
/literature/
/paper/
/gap_reports/

# The project's own run outputs behind the paper's numbers (the Pollock benchmark, the
# corpus survey and sweeps, the labelling study). An allowlist: the evidence a reader needs
# to check the paper is versioned, everything else stays out, including whatever a future
# run writes until it is named here. gap_reports/ is left to the review suite's reports.
/results/*
!/results/README.md
!/results/pollock/
!/results/labeling/
!/results/corpus_sweep/
/results/*/*
!/results/pollock/pollock_summary.md
!/results/pollock/pollock_rows_text.csv
!/results/pollock/pollock_rows_typed.csv
!/results/pollock/pollock_confidence_text.csv
!/results/pollock/pollock_confidence_typed.csv
!/results/pollock/pollock_refused_text.txt
!/results/pollock/pollock_refused_typed.txt
# Labelling study: the sample, tdy's readings, the votes and the verdicts, never the
# Prolific records (subs.json, annotator_stats.json, study.json, probe_*: participant ids).
!/results/labeling/*.md
!/results/labeling/*.py
!/results/labeling/final_verdicts.json
!/results/labeling/label_rows.jsonl
!/results/labeling/label_refusals.jsonl
!/results/labeling/label_sample_manifest.json
!/results/labeling/fresh_manifest.json
!/results/labeling/fresh_rows.jsonl
!/results/labeling/adjudicate_batch_*.json
!/results/labeling/flagged_batch_*.json
!/results/labeling/fresh_conf_batch_*.json
!/results/labeling/verify_batch_*.json
!/results/labeling/live_backend.out
!/results/corpus_sweep/*.out
!/results/corpus_sweep/corpus_csv_confidence_*.tsv
!/results/corpus_sweep/summary_sweep.json
!/results/corpus_sweep/skip_sweep.json

# subagent-driven-development scratch (ledgers, briefs, review packages)
/.superpowers/
